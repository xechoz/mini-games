{
  "name": "mini-games-site",
  "version": "4.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "site": "node site/build-site.ts",
    "site:local": "SITE_LOCAL=1 node site/build-site.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && biome check site",
    "test": "node --test site/*.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
